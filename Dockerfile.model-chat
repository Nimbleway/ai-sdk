# Cloudflare Containers execute linux/amd64 images; keep the build contract
# explicit so native dependencies are produced for the runtime architecture.
ARG MODEL_CHAT_PLATFORM=linux/amd64
FROM --platform=${MODEL_CHAT_PLATFORM} node:22-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true
WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json tsup.config.ts ./
COPY src ./src
COPY playground/model-chat ./playground/model-chat

RUN pnpm install --frozen-lockfile \
    && pnpm --filter @nimble-way/ai-sdk build \
    && pnpm --filter nimble-agent-v2-model-chat build \
    && pnpm --filter nimble-agent-v2-model-chat deploy --prod --legacy /app/model-chat-runtime \
    && cp -R /app/playground/model-chat/.next /app/model-chat-runtime/.next \
    && pnpm prune --prod \
    && /app/model-chat-runtime/node_modules/.bin/next --version

FROM --platform=${MODEL_CHAT_PLATFORM} node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app /app
EXPOSE 3211
CMD ["/app/model-chat-runtime/node_modules/.bin/next", "start", "/app/model-chat-runtime", "--port", "3211", "--hostname", "0.0.0.0"]

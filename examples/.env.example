# Copy to .env (or export these). Never commit real keys.

# Nimble API key — https://app.nimbleway.com
NIMBLE_API_KEY=

# OpenAI key for the model that drives the tool calls (any AI SDK model works).
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Deep-research agent instance for agent-research.ts (format wsa_...).
# Create one once in the Nimble console (or POST /v2/agents), then paste its id.
NIMBLE_AGENT_ID=

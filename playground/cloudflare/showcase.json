{
  "schema_version": 1,
  "integration_slug": "vercel-ai-sdk-nimble-v2",
  "framework": "vercel-ai-sdk",
  "runtime_command": ["npx", "wrangler", "dev"],
  "_implementation_status": "Administrator WebAuthn plus employee OTP and magic-link are locally implemented. Employee routes remain intentionally inactive while AUTH_ADMIN_ONLY=true; no deployment or live email/passkey ceremony is claimed.",
  "agent_api_v2": {
    "enabled": true,
    "identity_modes": ["auto", "agent_id"],
    "product_modes": ["research", "enrichment", "dataset_building"],
    "run_controls": [
      "input",
      "agent_name",
      "effort",
      "input_data",
      "output_schema",
      "sources",
      "skill",
      "use_case",
      "enable_events"
    ],
    "_effort_note": "The reusable adapter preserves the full API effort contract. The protected live UI and action boundary are separately fixed to low.",
    "allowed_efforts": ["low", "medium", "high", "x-high"],
    "gated_effort": {
      "tier": "max",
      "treatment": "positive_stop_before_create",
      "engagement_url": "https://www.nimbleway.com/contact",
      "closest_available": "x-high",
      "silent_degradation": false
    },
    "create_retries": 0,
    "client_source": "vercel-ai-sdk"
  },
  "authentication": {
    "employee_email_domain": "nimbleway.com",
    "employee_methods": ["otp", "magic_link"],
    "admin_method": "webauthn",
    "backend_default_deny": true
  },
  "evidence": {
    "raw_directory": "evidence/raw",
    "shareable_directory": "evidence/shareable",
    "requires_live_video": true,
    "requires_final_output_visible": true
  }
}

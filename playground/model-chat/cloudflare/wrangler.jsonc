{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vercel-ai-sdk-nimble-v2-playground",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTH_EMPLOYEE_ENABLED": "true",
    "SPEND_GRANT_EPOCH": "pr11-native-v2-review:1"
  },
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "allowed_sender_addresses": ["login@auth.kadosh.dev"]
    }
  ],
  "containers": [
    {
      "class_name": "ModelChatContainer",
      "image": "../../../Dockerfile.model-chat",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MODEL_CHAT", "class_name": "ModelChatContainer" },
      { "name": "ADMIN_AUTH", "class_name": "AdminAuthState" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AdminAuthState"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ModelChatContainer"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ChatAdmissionState"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["ChatAdmissionState"]
    }
  ],
  "observability": { "enabled": true }
}
